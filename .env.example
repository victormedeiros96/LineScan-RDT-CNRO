# Copie este arquivo para .env e ajuste os valores. Nunca commite o .env.
# O docker compose lê o .env da raiz do projeto e monta a DATABASE_URL do
# backend/worker a partir das variáveis abaixo.

POSTGRES_DB=rdt01
POSTGRES_USER=rdt01
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_PORT=5432

# Usada apenas ao rodar o backend fora do compose (local).
# Dentro do compose a DATABASE_URL é montada automaticamente.
# DATABASE_URL=postgresql://rdt01:troque-esta-senha@localhost:5432/rdt01

# Modelo de juntas do pavimento rígido (ICP, GPL-3.0).
# Rode ./scripts/baixar_modelo_trinca.sh para baixar código + pesos e ajuste
# ICP_MODEL_DIR se o destino não for /opt/trinca-detector.
# ICP_MODEL_DIR=/opt/trinca-detector
# ICP_NUCLIO_DIR=/opt/trinca-detector/nuclio
# ICP_MODELO_PT=/opt/trinca-detector/nuclio/modelos/trinca_junta_limpo_ts.pt
